# 此文件不自动加载。复制为 .env 后，使用：
# node --env-file=.env --import tsx server/index.ts --production
HOST=127.0.0.1
PORT=5173
NODE_ENV=production

# 可选 ICE 配置；留空时不使用任何第三方 STUN/TURN 服务。
# 使用分配给客户端的短期、受限 TURN 凭据，不能填写管理密钥。
# /api/config 会把这些使用凭据下发给浏览器。
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# 可选额外允许的 WebSocket 来源（逗号分隔）；默认要求与 Host 同源。
ALLOWED_ORIGINS=
